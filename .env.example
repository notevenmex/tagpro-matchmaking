# Copy to .env and fill in. Never commit .env.
SESSION_SECRET=change-me-to-a-long-random-string
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8000/auth/callback
# Comma-separated Discord user IDs who can report matches
ADMIN_DISCORD_IDS=
# sqlite for local; for Postgres use postgresql+psycopg://user:pass@host/db (and pip install "psycopg[binary]")
DATABASE_URL=sqlite:///./rankedpugs.db
# Set to 1 when served over HTTPS so the session cookie is secure-only
HTTPS_ONLY=0
# Local testing only: enables /auth/dev-login so you can sign in without Discord
DEV_LOGIN=0
# Matchmaking (defaults shown)
QUEUE_SIZE=8
READY_SECONDS=30
PICK_SECONDS=30
BAN_SECONDS=30
VOTE_SECONDS=20
QUEUE_BAN_MINUTES=5
MAP_POOL_SIZE=5
# top = two highest-rated players captain; random = two random players
CAPTAIN_MODE=top
SERVERS=US East,US Central,US West,Europe

# ---- Auto group bot (see docs/tagpro-groups.md) ----
# 1 = create the TagPro group automatically once a match is drafted, and DM both captains
AUTO_GROUP=0
# Discord bot token for the DMs (Developer Portal > your app > Bot). The bot must share a server with the captains.
DISCORD_BOT_TOKEN=
# Public URL of this site, used in the "make the group yourself" fallback DM
SITE_URL=
# The bot turns off Kissing Flag Carriers via the group page's experimental settings toggle.
# Optional: its socket name=value to send it directly instead (see docs/tagpro-groups.md)
TAGPRO_NOKISS_SETTING=
# 1 = treat a group as failed if Kissing Flag Carriers can't be turned off
TAGPRO_REQUIRE_NOKISS=1
# Optional: a "Group Preset" label to pick on TagPro's create form, e.g. Competitive
TAGPRO_GROUP_PRESET=
# Optional JSON overrides for group settings, e.g. {"time": "10", "overtime": "true"}
TAGPRO_GROUP_SETTINGS=
# Optional JSON map from our server names to TagPro's dropdown labels, e.g. {"US East": "New Jersey"}
TAGPRO_SERVER_MAP=
# Optional: TagPro session cookie value so groups are created by a TagPro account instead of a guest
TAGPRO_SESSION_COOKIE=
# How long the bot waits in the group for a captain before leaving (seconds)
TAGPRO_BOT_LINGER_SECONDS=600
